# Skopiuj ten plik jako .env (lokalnie) i uzupełnij wartości.
# Na Vercelu ustaw te same zmienne w Project Settings -> Environment Variables.
# UWAGA: NIE wpisuj tu prawdziwych wartości — ten plik jest w repozytorium.

# Hasło do panelu administratora (/admin)
ADMIN_PASSWORD=

# Baza danych PostgreSQL (np. Neon).
# DATABASE_URL  - polaczenie przez pooler (dla dzialajacej aplikacji)
# DIRECT_URL    - polaczenie bezposrednie (bez poolera), do migracji Prisma
# Format: postgres://UZYTKOWNIK:HASLO@HOST/BAZA?sslmode=require
DATABASE_URL=
DIRECT_URL=

# Sekret do podpisywania sesji (JWT). Wygeneruj: openssl rand -base64 32
SESSION_SECRET=

# Dostępność sprzętu z Google Sheets — opublikuj zakładkę (Plik > Udostepnij > Opublikuj w internecie > CSV)
# i wklej tu wygenerowany link. Kolumny: id, model, ilosc.
GOOGLE_SHEET_CSV_URL=
