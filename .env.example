# Skopiuj ten plik jako .env (lokalnie) i uzupełnij wartości.
# Na Vercelu ustaw te same zmienne w Project Settings → Environment Variables.

# Hasło do panelu administratora (/admin)
ADMIN_PASSWORD=twoje_haslo_tutaj

# Baza danych PostgreSQL (np. Neon)
# DATABASE_URL — połączenie przez pooler (dla działającej aplikacji)
DATABASE_URL="postgresql://user:haslo@host-pooler.region.aws.neon.tech/db?sslmode=require"
# DIRECT_URL — połączenie bezpośrednie (bez poolera), używane do migracji Prisma
DIRECT_URL="postgresql://user:haslo@host.region.aws.neon.tech/db?sslmode=require"

# Sekret do podpisywania sesji (JWT). Wygeneruj: openssl rand -base64 32
SESSION_SECRET="wygeneruj_losowy_ciag_32_bajty"
